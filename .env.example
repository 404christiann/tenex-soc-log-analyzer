# Supabase project URL, e.g. https://xxxxx.supabase.co (Project Settings > API)
SUPABASE_URL=

# Supabase anon/public key — safe for client-side use, respects RLS (Project Settings > API)
SUPABASE_ANON_KEY=

# Supabase service role key — server-side ONLY, bypasses RLS. Used only for the Storage
# upload write and the initial row inserts during processing (see DECISIONS.md §14a,
# "RLS enforcement — Option A"). Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the LLM judge (Claude Sonnet 5) and timeline summary (Claude Haiku 4.5).
# Optional: the app MUST run fully without this set. Missing/invalid keys surface as an honest
# `not_configured` / `failed` status per feature rather than breaking the app — see
# DECISIONS.md §14a "LLM graceful degradation".
ANTHROPIC_API_KEY=

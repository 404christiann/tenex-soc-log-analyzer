{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tenex/shared": ["../../packages/shared/src/index.ts"],
      "@tenex/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
